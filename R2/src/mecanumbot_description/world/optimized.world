<?xml version="1.0" ?>
<sdf version="1.7">
    <world name="optimized_world">
        <!-- Physics Configuration - Optimized untuk mengurangi trimesh collision issues -->
        <physics type="ode">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
            <real_time_update_rate>1000</real_time_update_rate>
            <ode>
                <solver>
                    <type>quick</type>
                    <iters>100</iters>
                    <sor>1.3</sor>
                    <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
                </solver>
                <constraints>
                    <cfm>0.0</cfm>
                    <erp>0.2</erp>
                    <contact_max_correcting_vel>1000</contact_max_correcting_vel>
                    <contact_surface_layer>0.0001</contact_surface_layer>
                </constraints>
            </ode>
        </physics>
        
        <gravity>0 0 -9.8</gravity>
        
        <!-- Lighting -->
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>
        
        <!-- Ground Plane dengan collision sederhana -->
        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>100.0</mu>
                                <mu2>100.0</mu2>
                                <kp>1e15</kp>
                                <kd>1e13</kd>
                            </ode>
                        </friction>
                        <bounce>
                            <restitution_coefficient>0.0</restitution_coefficient>
                            <threshold>1</threshold>
                        </bounce>
                        <contact>
                            <ode>
                                <max_vel>0.01</max_vel>
                                <min_depth>0.001</min_depth>
                            </ode>
                        </contact>
                    </surface>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.5 0.5 0.5 1</specular>
                    </material>
                </visual>
            </link>
        </model>
        
        <!-- Map Model - Dengan optimized collision settings -->
        <model name="robocon_map">
            <static>true</static>
            <pose>0 0 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <mesh>
                            <uri>package://mecanumbot_description/models/robocon.dae</uri>
                        </mesh>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>100.0</mu>
                                <mu2>100.0</mu2>
                                <kp>1e15</kp>
                                <kd>1e13</kd>
                            </ode>
                        </friction>
                        <bounce>
                            <restitution_coefficient>0.0</restitution_coefficient>
                            <threshold>1</threshold>
                        </bounce>
                        <contact>
                            <ode>
                                <max_vel>0.01</max_vel>
                                <min_depth>0.001</min_depth>
                            </ode>
                        </contact>
                    </surface>
                </collision>
                <visual name="visual">
                    <geometry>
                        <mesh>
                            <uri>package://mecanumbot_description/models/robocon.dae</uri>
                        </mesh>
                    </geometry>
                </visual>
            </link>
        </model>
        
        <!-- Scene settings -->
        <scene>
            <ambient>0.4 0.4 0.4 1</ambient>
            <background>0.7 0.7 0.7 1</background>
            <shadows>true</shadows>
        </scene>
    </world>
</sdf>