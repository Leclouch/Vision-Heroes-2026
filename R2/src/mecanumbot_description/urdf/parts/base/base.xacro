<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="base">
	<link name="base_link">
	  <visual>
		  <geometry>
		    <mesh filename="package://mecanumbot_description/meshes/DAE/base/base.dae"/>
		  </geometry>
	  </visual>
	  <collision>
		  <!-- Menggunakan box alih-alih mesh untuk mengurangi trimesh collision -->
		  <geometry>
		    <box size="0.3302 0.3302 0.102"/>
		  </geometry>
          <surface>
            <friction>
              <ode>
                <mu>10.0</mu>
                <mu2>10.0</mu2>
                <kp>1e15</kp>
                <kd>1e13</kd>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
            <bounce>
              <restitution_coefficient>0.0</restitution_coefficient>
              <threshold>1</threshold>
            </bounce>
            <contact>
              <ode>
                <max_vel>0.01</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
	  </collision>
	  <inertial>
		  <origin xyz="0 0 0"/>
		  <mass value="2"/> 
		<inertia ixx="2.92" ixy="0" ixz="0" iyy="18.03" iyz="0" izz="20.95" />
	  </inertial>
	</link>
  </xacro:macro>
</robot>