<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  
  <xacro:macro name="roller_v0" params="prefix parent *joint_origin *joint_axis">
	<joint name="${prefix}_roller_joint" type="continuous">
	  <xacro:insert_block name="joint_origin"/>
	  <parent link="${parent}"/>
	  <child link="${prefix}_roller_link"/>
	  <xacro:insert_block name="joint_axis"/>
	</joint>

	<link name="${prefix}_roller_link">
	  <visual>
		<geometry>
		  <mesh filename="package://mecanumbot_description/meshes/DAE/roller/roller.dae"/>
		</geometry>
	  </visual>
	  <collision>
		<!-- Menggunakan capsule/cylinder alih-alih mesh untuk mengurangi trimesh collision -->
		<geometry>
		  <cylinder radius="0.006" length="0.028"/>
		</geometry>
          <surface>
            <friction>
              <ode>
                <mu1>10.0</mu1>
                <mu2>10.0</mu2>
                <kp>1e15</kp>
                <kd>1e13</kd>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
            <bounce>
              <restitution_coefficient>0.0</restitution_coefficient>
              <threshold>0</threshold>
            </bounce>
            <contact>
              <ode>
                <max_vel>0.01</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
	  </collision>
	  <inertial>
		<origin xyz="0.0 0.0 0.0"/>
		<mass value="0.009"/>
		<inertia ixx="0.000001257" ixy="0" ixz="0" iyy="0.000000342" iyz="0" izz="0.000001257"/>
	  </inertial>
	</link>
  </xacro:macro>
  
</robot>
